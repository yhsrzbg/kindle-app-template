#!/bin/sh
set -eu

export DISPLAY="${DISPLAY:-:0}"
pid_file="/tmp/@APP_ID@.pid"
log_file="/tmp/@APP_ID@.log"

if [ -f "$pid_file" ]; then
  old_pid=$(cat "$pid_file" 2>/dev/null || true)
  if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
    echo "Application is already running (PID $old_pid)."
    exit 0
  fi
fi

echo $$ > "$pid_file"
trap 'rm -f "$pid_file"' EXIT HUP INT TERM
{
  echo "=== Application started at $(date) ==="
  echo "DISPLAY=$DISPLAY"
  uname -a
} >> "$log_file" 2>&1

"./bin/@BINARY_NAME@" >> "$log_file" 2>&1
